{
  "family": "sinergia-prod-backend",
  "containerDefinitions": [
    {
      "name": "app",
      "image": "388252588223.dkr.ecr.eu-south-2.amazonaws.com/task-image:2025-08-31-21-11-9803192",
      "cpu": 1024,
      "portMappings": [
        {
          "name": "app-80-tcp",
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "S3_BUCKET_BACK",
          "value": "sinergia-prod-backend"
        }
      ],
      "environmentFiles": [],
      "mountPoints": [],
      "volumesFrom": [],
      "secrets": [
        {
          "name": "SECURITY_JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:eu-south-2:388252588223:secret:sinergia-prod-env-lGpG0b:SECURITY_JWT_SECRET::"
        },
        {
          "name": "SECURITY_API_SECRET",
          "valueFrom": "arn:aws:secretsmanager:eu-south-2:388252588223:secret:sinergia-prod-env-lGpG0b:SECURITY_API_SECRET::"
        },
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:eu-south-2:388252588223:secret:sinergia-prod-env-lGpG0b:DATABASE_URL::"
        },
        {
          "name": "DATABASE_USERNAME",
          "valueFrom": "arn:aws:secretsmanager:eu-south-2:388252588223:secret:sinergia-prod-env-lGpG0b:DATABASE_USERNAME::"
        },
        {
          "name": "DATABASE_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:eu-south-2:388252588223:secret:sinergia-prod-env-lGpG0b:DATABASE_PASSWORD::"
        }
      ],
      "ulimits": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/sinergia-prod-backend",
          "awslogs-create-group": "true",
          "awslogs-region": "eu-south-2",
          "awslogs-stream-prefix": "ecs"
        },
        "secretOptions": []
      },
      "systemControls": []
    }
  ],
  "taskRoleArn": "arn:aws:iam::388252588223:role/sinergia-prod-task-role",
  "executionRoleArn": "arn:aws:iam::388252588223:role/sinergia-prod-task-execution-role",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "2048",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  }
}