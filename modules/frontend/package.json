{
  "name": "fixriver",
  "private": true,
  "version": "0.0.0",
  "description": "FixRiver Dashboard Application",
  "author": "FixRiver Team",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --mode development",
    "start:dev": "npm run build:react:development && electron .",
    "start:electron": "electron .",
    "build:react:development": "tsc -b && vite build --mode development",
    "build:react:production": "tsc -b && vite build --mode production",
    "build:electron": "npx electron-builder",
    "preview": "vite preview",
    "lint:format": "biome format --write ./src",
    "lint:check": "biome lint ./src",
    "lint:apply": "biome check --write ./src",
    "lint": "npm lint:format && npm lint:check && npm lint:apply",
    "transpile:electron": "tsc --project src/electron/tsconfig.json",
    "dist:mac:production": "npm run transpile:electron && npm run build:react:production && electron-builder --mac --arm64",
    "dist:win:production": "npm run transpile:electron && npm run build:react:production && electron-builder --win --x64",
    "dist:linux:production": "npm run transpile:electron && npm run build:react:production && electron-builder --linux --x64",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@radix-ui/react-avatar": "1.1.10",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-slot": "1.2.3",
    "@tailwindcss/vite": "4.1.14",
    "@tanstack/react-query": "5.90.2",
    "axios": "1.12.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.545.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "7.64.0",
    "react-icons": "5.5.0",
    "react-router": "7.9.4",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1",
    "tailwindcss-animate": "1.0.7",
    "zod": "4.1.12",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.5",
    "@types/node": "24.7.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react-swc": "4.1.0",
    "autoprefixer": "10.4.21",
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12",
    "husky": "9.1.7",
    "lint-staged": "16.2.3",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.14",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "7.1.9"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome format --write --no-errors-on-unmatched",
      "biome lint --write --no-errors-on-unmatched",
      "biome check --files-ignore-unknown=true",
      "biome check --write --no-errors-on-unmatched",
      "biome check --write --unsafe --no-errors-on-unmatched"
    ]
  }
}
